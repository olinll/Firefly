---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import UmamiPageViews from "@/components/analytics/UmamiPageViews.astro";
import FriendFeedGroup from "@/components/pages/friends/FriendFeedGroup.astro";
import {
	commentConfig,
	friendsFeedGroups,
	friendsPageConfig,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/friends.css";

if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");
if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
const isCommentEnabled = Boolean(
	commentConfig?.type &&
		commentConfig.type !== "none" &&
		friendsPageConfig.showComment !== false,
);
---

<MainGridLayout title={title} description={description}>
	<section class="friends-feed-page" aria-labelledby="friends-page-title">
		<div class="friends-feed-header">
			<div class="friends-feed-heading">
				<div class="friends-feed-icon" aria-hidden="true">
					<Icon name="material-symbols:group-rounded" />
				</div>
				<div>
					<h2 id="friends-page-title">{title}</h2>
					<p>{description}</p>
				</div>
				<UmamiPageViews path="/friends/" variant="badge" className="friends-feed-views" />
			</div>
		</div>

		{friendsFeedGroups.length > 0 ? (
			friendsFeedGroups.map((group) => <FriendFeedGroup group={group} />)
		) : (
			<div class="friends-feed-empty">
				<Icon name="material-symbols:link-off-rounded" />
				<p>{i18n(I18nKey.friendsEmpty)}</p>
			</div>
		)}
	</section>

	{friendsPageConfig.showCustomContent !== false && (
		<div class="friends-custom-content card-base">
			<Markdown class="friends-custom-markdown">
				<Content />
			</Markdown>
		</div>
	)}

	{isCommentEnabled && (
		<div class="mt-4">
			<Comment post={friendsPost} customPath="/friends/" />
		</div>
	)}
</MainGridLayout>
