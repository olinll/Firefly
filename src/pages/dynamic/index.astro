---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import DynamicCover from "@/components/pages/dynamic/DynamicCover.astro";
import DynamicFeed from "@/components/pages/dynamic/DynamicFeed.svelte";
import DynamicItemTemplate from "@/components/pages/dynamic/DynamicItemTemplate.astro";
import { commentConfig, dynamicConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/dynamic.css";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.dynamic) {
	return Astro.redirect("/404/");
}

const title = dynamicConfig.title || i18n(I18nKey.dynamic);
const description =
	dynamicConfig.description || i18n(I18nKey.dynamicDescription);
const itemsPerPage = Math.max(1, dynamicConfig.itemsPerPage ?? 10);
const showInlineComments = Boolean(
	dynamicConfig.showComment !== false &&
		commentConfig.type &&
		commentConfig.type !== "none",
);
const dataUrl = dynamicConfig.apiUrl?.startsWith("http")
	? dynamicConfig.apiUrl
	: url(dynamicConfig.apiUrl || "/api/dynamic.json");
const memos = dynamicConfig.memos;
let dynamicCount = 0;

if (memos?.enable && memos.apiUrl) {
	try {
		const response = await fetch(`${memos.apiUrl}/api/v1/memos?pageSize=1000`);
		if (response.ok) {
			const data = (await response.json()) as {
				memos?: Array<{ state?: string }>;
			};
			dynamicCount = (data.memos || []).filter(
				(memo) => memo.state === "NORMAL",
			).length;
		}
	} catch {
		// The client-side feed remains available if the build-time count request fails.
	}
}

if (!dynamicCount && !memos?.enable) {
	dynamicCount = (await getCollection("dynamic")).length;
}
---

<MainGridLayout title={title} description={description}>
	<section class="dynamic-page" aria-labelledby="dynamic-page-title">
		<div>
			{dynamicConfig.cover?.enable ? (
				<DynamicCover title={title} description={description} {dynamicCount} />
			) : (
			<header class="dynamic-page-header card-base">
				<div class="dynamic-page-heading">
					<div class="dynamic-page-icon" aria-hidden="true">
						<Icon name="material-symbols:forum-rounded" />
					</div>
					<div>
						<h2 id="dynamic-page-title">{title}</h2>
						{description && <p>{description}</p>}
					</div>
				</div>
				<div
					class="dynamic-count"
					aria-label={i18n(I18nKey.dynamic)}
				>
					<Icon name="material-symbols:dynamic-feed-rounded" />
					<strong data-dynamic-page-count>{dynamicCount}</strong>
					<span>{i18n(I18nKey.dynamic)}</span>
				</div>
				<div class="dynamic-filter">
					<label class="dynamic-search">
						<Icon name="material-symbols:search-rounded" />
						<input
							type="search"
							data-dynamic-search
							placeholder={i18n(I18nKey.dynamicSearch)}
						/>
					</label>
					<label class="dynamic-year-select">
						<Icon name="material-symbols:calendar-month-rounded" />
						<select data-year-select aria-label={i18n(I18nKey.year)}>
							<option value="all">{i18n(I18nKey.dynamicAllYears)}</option>
						</select>
						<Icon name="material-symbols:arrow-drop-down-rounded" />
					</label>
				</div>
			</header>
			)}

			<DynamicFeed
				client:load
				source={dataUrl}
				{itemsPerPage}
				showComments={showInlineComments}
				emptyText={i18n(I18nKey.dynamicEmpty)}
				noResultsText={i18n(I18nKey.dynamicNoResults)}
				loadingText={i18n(I18nKey.dynamicLoading)}
				allYearsText={i18n(I18nKey.dynamicAllYears)}
				timezone={siteConfig.timezone || "UTC"}
				{memos}
			/>

			<DynamicItemTemplate />
		</div>
	</section>
</MainGridLayout>
